# Connection defaults for every host (installed by scripts/install-remote.sh; managed in the repo).
# ssh uses the FIRST value it finds, so this file is last: anything in 10-devices, 20-personal or ~/.ssh/config wins.

Host *.local
  CheckHostIP no

Host *
  AddKeysToAgent yes
  # a second connection to the same host opens instantly (VS Code, Files, rsync and terminals share one)
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
  # notice a dead link in about a minute instead of hanging
  ServerAliveInterval 15
  ServerAliveCountMax 4
  ConnectTimeout 10
  # learn a device's new host keys when it rotates them; readable known_hosts for `board forget`
  UpdateHostKeys yes
  HashKnownHosts no
  ForwardAgent no
