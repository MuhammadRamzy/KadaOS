#!/usr/bin/env bash
# ai-dictate [toggle|start|stop|status] — LIVE voice typing (Super+D).
# Speak naturally: a live preview shows your words; each phrase is typed into the focused app when you pause.
# Whisper runs on the RTX 5050 (whisper-server service, started on demand, stopped 2 min after you finish).
set -u
R="${XDG_RUNTIME_DIR:-/tmp}"; pidf="$R/dictate.pid"
# Serialize start/stop/idle expiry so an old expiry cannot interrupt a new start.
if [ "${1:-toggle}" != status ] && [ "${1:-toggle}" != worker ]; then
  exec 9>"$R/dictate-control.lock"
  flock -w 65 9 || exit 1
fi
n(){ notify-send -t "${2:-3000}" -h string:x-canonical-private-synchronous:dictate "Dictation" "$1"; }
recording(){
  [ -f "$pidf" ] || return 1
  local pid; pid=$(cat "$pidf")
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  grep -zFq -- "$HOME/.local/share/local-ai/dictate-live.py" "/proc/$pid/cmdline" 2>/dev/null
}
server_up(){ curl -s -o /dev/null --max-time 1 127.0.0.1:8178; }
start(){
  recording && return
  command -v whisper-server >/dev/null || { n "Whisper not installed. Run: bash ~/KadaOS/scripts/phase10-ai-desktop.sh" 6000; exit 1; }
  if ! server_up; then
    n "Starting speech engine…" 3000
    systemctl --user start whisper-server
    for _ in $(seq 1 300); do server_up && break; sleep 0.2; done
    server_up || { n "Speech engine failed to start (systemctl --user status whisper-server)" 6000; exit 1; }
  fi
  setsid -f "$0" worker >/dev/null 2>&1 9>&-
  for _ in $(seq 1 100); do recording && break; sleep 0.05; done
  pkill -RTMIN+10 waybar
}
stop(){
  recording || { rm -f "$pidf"; return; }
  kill -TERM "$(cat "$pidf")"
  # The worker schedules release after manual stops, silence, or a crash.
}
worker(){
  # Publish the child's PID before Python imports numpy. The controller lock
  # covers this handshake, so an old expiry cannot stop a starting session.
  python3 "$HOME/.local/share/local-ai/dictate-live.py" &
  local pid=$!
  printf '%s\n' "$pid" > "$pidf"
  wait "$pid"
  if [ "$(cat "$pidf" 2>/dev/null)" = "$pid" ]; then rm -f -- "$pidf"; fi
  sleep 120
  "$0" expire
}
case "${1:-toggle}" in
  start) start;; stop) stop;; worker) worker;;
  expire)
    if ! recording && ! { [ -s "$R/voice-ask.pid" ] && kill -0 "$(cat "$R/voice-ask.pid")" 2>/dev/null; }; then
      systemctl --user stop whisper-server
    fi;;
  toggle) if recording; then stop; else start; fi;;
  status) if recording; then printf '{"text":"%s REC","class":"rec","tooltip":"Live dictation on – press Super+D to stop"}\n' $'\U000F036C'; else echo '{"text":"","class":"idle"}'; fi;;
esac
