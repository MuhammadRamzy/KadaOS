/* generated by scripts/theme.py — Graphite */
* {
  bg: #17171aeb; bg-alt: rgba(255,255,255,0.06); bg-sel: #5b9cff; fg: #f2f2f5; fg-dim: #8b8b92;
  accent: #5b9cff;
  font: "Adwaita Sans 12";
  background-color: transparent; text-color: @fg; margin: 0; padding: 0; spacing: 0;
}
window { width: 640px; location: center; anchor: center; y-offset: -80px; background-color: @bg;
  border: 1px; border-color: rgba(255,255,255,0.1); border-radius: 16px; }
mainbox { padding: 10px; spacing: 8px; children: [ inputbar, message, listview ]; }
inputbar { padding: 10px 12px; spacing: 10px; border: 0 0 1px 0; border-color: rgba(255,255,255,0.08); children: [ prompt, entry ]; }
prompt { text-color: @fg-dim; }
entry {
  placeholder: "Type to search";
  placeholder-color: @fg-dim; cursor: text;
  font: "Adwaita Sans 15";
}
message { padding: 4px 12px; }
textbox { text-color: @fg-dim; font: "Adwaita Sans 10.5"; }
listview { lines: 8; columns: 1; fixed-height: false; scrollbar: false; spacing: 2px; cycle: true; }
element { padding: 8px 12px; border-radius: 10px; spacing: 12px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @bg-sel; text-color: #0e0e10; }
element-icon { size: 30px; }
element-text { vertical-align: 0.5; text-color: inherit; }
mode-switcher { spacing: 6px; }
button { padding: 6px; border-radius: 8px; background-color: @bg-alt; text-color: @fg-dim; }
button selected { background-color: @accent; text-color: #0e0e10; }
