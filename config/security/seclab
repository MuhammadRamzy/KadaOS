#!/usr/bin/env python3
"""Security workbench. Menu tools show help; explicit CLI arguments pass through.

Engagements keep authorized work in one place: ~/Engagements/NAME/{scope.txt, notes.md, log.md, scans/, loot/}.
`seclab run RECIPE TARGET` only runs against targets listed in the active engagement's scope, saves the
output under scans/ and appends a line to log.md (a timeline for the report).
`seclab finding "Title" -s high -t TARGET` records a finding (findings/NNN-title.md); `seclab report` builds
report.md, report.html and report.pdf: summary by severity, scope, findings worst first, timeline, scan list.
`seclab wifi` tells a USB monitor-mode adapter from the built-in card (`seclab wifi layout` opens the wireless layout);
`seclab ctf NAME` makes ~/CTF/NAME and opens a CTF workspace; `seclab lab up|down|remove` an isolated VM network."""
import datetime
import ipaddress
import json
import os
import re
import urllib.parse
from pathlib import Path
import shutil
import subprocess
import sys

TOOLS = json.loads((Path(__file__).resolve().parent / 'tools.json').read_text())
BY_NAME = {t['name']: t for t in TOOLS}

def check(category=None):
    missing = 0
    for tool in TOOLS:
        if category and tool['category'] != category:
            continue
        path = shutil.which(tool['name'])
        print(f"{'PASS' if path else 'FAIL'} {tool['name']}: {path or 'not on PATH'}")
        missing += not bool(path)
    print(f'{missing} missing commands (presence check; not a functional test).')
    return min(missing, 125)

