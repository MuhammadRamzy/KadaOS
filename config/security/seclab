    ('recon', 'Recon & enumeration', 'system-search-symbolic'),
    ('network', 'Network', 'network-wired-symbolic'),
    ('web', 'Web apps', 'web-browser-symbolic'),
    ('wireless', 'Wi-Fi & wireless', 'network-wireless-symbolic'),
    ('re', 'Reverse engineering & mobile', 'application-x-executable-symbolic'),
    ('forensics', 'Forensics', 'drive-harddisk-symbolic'),
    ('cloud', 'Cloud', 'network-server-symbolic'),
    ('frameworks', 'Frameworks', 'applications-system-symbolic'),
]

# ── engagements ─────────────────────────────────────────────────────────────
ENG_ROOT = Path(os.environ.get('SECLAB_ROOT', Path.home() / 'Engagements'))
ACTIVE = Path(os.environ.get('SECLAB_STATE', Path.home() / '.local/state/seclab')) / 'active'
WORDLIST = '/usr/share/dirb/wordlists/common.txt'
# argv templates (never a shell). {t} = target host/IP/CIDR, {u} = URL, {o} = output path without extension.
RECIPES = {
    'lan-discover':  ('Find live devices (ping sweep)',      ['nmap', '-sn', '{t}', '-oA', '{o}']),
    'nmap-quick':    ('Quick port scan (top 100)',          ['nmap', '-T4', '-F', '{t}', '-oA', '{o}']),
    'nmap-services': ('Service + default scripts',          ['nmap', '-sV', '-sC', '-T4', '{t}', '-oA', '{o}']),
    'nmap-full':     ('All 65535 TCP ports',                ['nmap', '-p-', '-T4', '{t}', '-oA', '{o}']),
    'nmap-vuln':     ('Known-vulnerability scripts',        ['nmap', '-sV', '--script', 'vuln', '-T4', '{t}', '-oA', '{o}']),
    'web-fingerprint': ('Identify web stack',               ['whatweb', '-a', '3', '{u}']),
    'web-dirs':      ('Directory brute force (dirb common)', ['gobuster', 'dir', '-u', '{u}', '-w', WORDLIST, '-q']),
    'web-nikto':     ('Web server misconfig scan',          ['nikto', '-h', '{u}']),
