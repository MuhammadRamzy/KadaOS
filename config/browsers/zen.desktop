[Desktop Entry]
Type=Application
Name=Zen Browser
GenericName=Web Browser (work, many tabs)
Comment=Firefox-based browser with workspaces and vertical tabs
Exec=@ZEN@ %u
Icon=@ICON@
Terminal=false
StartupNotify=true
StartupWMClass=zen
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;browser;internet;tabs;work;firefox;
Actions=new-window;new-private-window;import;

[Desktop Action new-window]
Name=New Window
Exec=@ZEN@ --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=@ZEN@ --private-window %u

[Desktop Action import]
Name=Import from Chrome
Exec=@ZEN@ --migration
