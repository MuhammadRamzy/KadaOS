# KadaOS boot screen (Plymouth script module): the login's look, smaller. Graphite, the KadaOS mark as glass in
# the middle, its cursor glowing blue and breathing. A disk-password prompt and boot messages appear under the mark.
Window.SetBackgroundTopColor(0.067, 0.067, 0.075);      # #111113, same as the login screen
Window.SetBackgroundBottomColor(0.067, 0.067, 0.075);

W = Window.GetWidth(); H = Window.GetHeight(); X = Window.GetX(); Y = Window.GetY();
cx = X + W / 2; cy = Y + H / 2;

# render.py boot_assets(): the mark is 80x72 units at 3 px/unit; cursor.png is the cursor padded 14 units for its glow
mark = Sprite(Image("mark.png"));
mx = cx - 120; my = cy - 132;                            # the 240x216 mark, a little above centre
mark.SetPosition(mx, my, 1);
cursor = Sprite(Image("cursor.png"));
cursor.SetPosition(mx + 78, my + 150, 2);                # (64-14-24, 88-14-24) units x 3

global.t = 0;
fun refresh() {                                          # ~50 calls a second: a slow 2.4 s breath, never fully off
  global.t = (global.t + 1) % 120;
  if (global.t < 60) a = global.t / 60; else a = (120 - global.t) / 60;
  cursor.SetOpacity(0.35 + 0.65 * a * a * (3 - 2 * a));  # smoothstep
}
Plymouth.SetRefreshFunction(refresh);

# ── messages (e.g. "checking disk") ──
msg = Sprite(); msg.SetPosition(cx, cy + 220, 3);
fun show_message(text) {
  img = Image.Text(text, 0.75, 0.75, 0.78, 1, "Sans 11");
  msg.SetImage(img); msg.SetX(cx - img.GetWidth() / 2); msg.SetOpacity(1);
}
Plymouth.SetMessageFunction(show_message);
Plymouth.SetDisplayMessageFunction(show_message);
fun hide_message(text) { msg.SetOpacity(0); }
Plymouth.SetHideMessageFunction(hide_message);

# ── disk password ──
prompt = Sprite(); prompt.SetPosition(cx, cy + 150, 3);
dots = Sprite(); dots.SetPosition(cx, cy + 182, 3);
fun display_password(text, bullets) {
  p = Image.Text(text, 0.75, 0.75, 0.78, 1, "Sans 11");
  prompt.SetImage(p); prompt.SetX(cx - p.GetWidth() / 2); prompt.SetOpacity(1);
  s = ""; for (i = 0; i < bullets; i++) s = s + "● ";
  if (bullets == 0) s = "_";
  d = Image.Text(s, 1, 1, 1, 1, "Sans 14");
  dots.SetImage(d); dots.SetX(cx - d.GetWidth() / 2); dots.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password);
fun display_normal() { prompt.SetOpacity(0); dots.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal);
fun display_question(text, entry) { display_password(text, 0); d = Image.Text(entry, 1, 1, 1, 1, "Sans 14"); dots.SetImage(d); dots.SetX(cx - d.GetWidth() / 2); }
Plymouth.SetDisplayQuestionFunction(display_question);
